# =============================================================================
# secrag — environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed. The server loads it via python-dotenv on startup.
# =============================================================================

# --- Database (Supabase Postgres / connection pooler) ------------------------
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=6543
DB_PASS=your_database_password

# --- App secrets -------------------------------------------------------------
# Generate strong random values, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
FLASK_KEY_SECRET=your_flask_session_secret
JWT_SECRET=your_jwt_signing_secret

# --- Email (Gmail SMTP w/ App Password) --------------------------------------
MAIL_SENDER_USER=your_sender@gmail.com
MAIL_SENDER_PASS=your_gmail_app_password
MAIL_CONTACT_USER=your_contact@gmail.com

# --- Stripe ------------------------------------------------------------------
# Use test keys in dev, live keys in prod. Webhook secret differs per env.
STRIPE_KEY=sk_test_or_live_...
STRIPE_WEBHOOK_KEY=whsec_...
STRIPE_PRODUCT_BASIC_MONTHLY=price_...
STRIPE_PRODUCT_BASIC_YEARLY=price_...
STRIPE_PRODUCT_PREMIUM_MONTHLY=price_...
STRIPE_PRODUCT_PREMIUM_YEARLY=price_...
STRIPE_PRODUCT_REPLENISH=price_...

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# --- LLM providers -----------------------------------------------------------
OPENAI_API_KEY=sk-proj-...
GOOGLE_API_KEY=your_google_generative_ai_key

# --- MongoDB (chat history) --------------------------------------------------
MONGO_URI=mongodb+srv://user:pass@cluster/...

# --- GitHub webhook (auto-deploy hook) ---------------------------------------
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# --- SEC EDGAR (edgartools) --------------------------------------------------
# SEC requires an identifying User-Agent: "Name email@domain.com"
EDGAR_IDENTITY=Your Name your_email@domain.com
EDGAR_USE_LOCAL_DATA=False
EDGAR_LOCAL_DATA_DIR=

# --- Cron logging (Telegram alerts + Logtail) --------------------------------
TELEGRAM_BOT_KEY=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
LOGTAIL_SOURCE_TOKEN=your_logtail_source_token

# --- Misc --------------------------------------------------------------------
REDIRECT_URL=http://localhost:5000
